# Spring reads exported environment variables; this file is a template, not auto-loaded.
SPRING_PROFILES_ACTIVE=mysql
DB_URL=jdbc:mysql://127.0.0.1:3307/skope?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=skope
DB_PASSWORD=
# At least 12 characters. New demo accounts only; existing passwords are not reset.
DEMO_PASSWORD=
PORT=8080
COOKIE_SECURE=false
AI_MODE=DEMO
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_COMPLETION_TOKENS=1536
# Blank omits this option. Recommended gpt-6-luna trial: none.
AI_REASONING_EFFORT=
EMBEDDING_MODE=RULE_ONLY
EMBEDDING_MODEL=
# Experimental, not calibrated on live embeddings.
SKOPE_SIMILARITY_THRESHOLD=0.82
SKOPE_SIMILARITY_WINDOW_DAYS=30
