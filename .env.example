# Spring reads exported environment variables; this file is a template, not auto-loaded.
SPRING_PROFILES_ACTIVE=mysql
DB_URL=jdbc:mysql://127.0.0.1:3307/skope?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=skope
DB_PASSWORD=
# At least 12 characters. New demo accounts only; existing passwords are not reset.
DEMO_PASSWORD=
PORT=8080
COOKIE_SECURE=false
# Public HTTPS deployments: set COOKIE_SECURE=true and enable the auth request limiter.
# Keep backend/MySQL on loopback and serve frontend + /api through one HTTPS origin.
PUBLIC_AUTH_LIMIT_ENABLED=false
PUBLIC_AUTH_LOGIN_PER_MINUTE=120
PUBLIC_AUTH_REGISTER_PER_MINUTE=10
AI_MODE=DEMO
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_COMPLETION_TOKENS=1536
# Blank omits this option. Recommended gpt-6-luna trial: none.
AI_REASONING_EFFORT=
EMBEDDING_MODE=RULE_ONLY
# Scope-aware similarity evaluation recommends this model; existing stored vectors need bounded reindexing.
EMBEDDING_MODEL=text-embedding-3-large
# Set explicit deployment limits. These are app estimates, separate from provider billing controls.
AI_BUDGET_PERIOD=TOTAL
AI_BUDGET_MAX_USD=1.00
AI_BUDGET_MAX_LLM_CALLS=200
AI_BUDGET_MAX_EMBEDDING_CALLS=200
AI_PRICE_INPUT_PER_MTOK=0.10
AI_PRICE_OUTPUT_PER_MTOK=0.50
# Model-specific estimate: large=0.13; set 0.02 if explicitly retaining text-embedding-3-small.
EMBEDDING_PRICE_PER_MTOK=0.13
# Experimental, not calibrated on live embeddings.
SKOPE_SIMILARITY_THRESHOLD=0.82
SKOPE_SIMILARITY_WINDOW_DAYS=30

# Explicit opt-in for assumed department routes; independent of AI_MODE.
DEMO_ROUTING_ENABLED=false
