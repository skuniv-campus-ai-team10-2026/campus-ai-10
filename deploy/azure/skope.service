[Unit]
Description=SKOPE backend (Spring Boot)
Wants=network-online.target
After=network-online.target mysql.service
Requires=mysql.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=skope
Group=skope
EnvironmentFile=/etc/skope/skope.env
WorkingDirectory=/opt/skope/app
ExecStart=/usr/bin/java -Xms256m -Xmx1536m -XX:+ExitOnOutOfMemoryError -jar /opt/skope/app/skope.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Hardening: the service can only write its own data folder and app folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/skope /opt/skope/app

[Install]
WantedBy=multi-user.target
