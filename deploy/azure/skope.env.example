# SKOPE backend settings on the VM. install.sh copies this to /etc/skope/skope.env (root only, 0600)
# and fills the two __...__ values with random secrets. Never commit the filled file.

SPRING_PROFILES_ACTIVE=mysql
PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3306/skope?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=skope
DB_PASSWORD=__DB_PASSWORD__

# Seeds student1/student2/admin only when they do not exist yet. Never resets existing passwords.
DEMO_PASSWORD=__DEMO_PASSWORD__
APP_DEMO_RESET_PASSWORD=false

# Behind Caddy over HTTPS: secure session cookie and trust X-Forwarded-* from the local proxy only
# (the backend listens on 127.0.0.1, so only Caddy can reach it).
COOKIE_SECURE=true
SERVER_FORWARD_HEADERS_STRATEGY=framework

ATTACHMENT_DIR=/var/lib/skope/attachments

# Same as the team preview. Demo-only routes (LEAK, HVAC, WATER_DISPENSER) are labelled DEMO and show no contact.
DEMO_ROUTING_ENABLED=true

# First deployment: no paid AI calls.
AI_MODE=DEMO
EMBEDDING_MODE=RULE_ONLY

# LIVE switch (owner: team lead). Fill on the server only, then: sudo systemctl restart skope
# AI_MODE=LIVE
# EMBEDDING_MODE=LIVE
# AI_API_KEY=
# AI_MODEL=gpt-6-luna
# EMBEDDING_MODEL=text-embedding-3-small
# AI_REASONING_EFFORT=none
# AI_BUDGET_PERIOD=TOTAL
# AI_BUDGET_MAX_USD=
# AI_BUDGET_MAX_LLM_CALLS=
# AI_BUDGET_MAX_EMBEDDING_CALLS=
# AI_PRICE_INPUT_PER_MTOK=0.10
# AI_PRICE_OUTPUT_PER_MTOK=0.50
# EMBEDDING_PRICE_PER_MTOK=0.02
