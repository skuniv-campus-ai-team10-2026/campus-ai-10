{
	admin off
	auto_https off
}

http://127.0.0.1:{$SHARE_PORT:4186} {
	bind 127.0.0.1
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	@api path /api /api/*
	handle @api {
		request_body {
			max_size 6291456
		}
		header >Cache-Control "no-store"
		reverse_proxy 127.0.0.1:{$BACKEND_PORT:8086} {
			# Loopback-only origin behind an HTTPS Quick Tunnel.
			header_up -Forwarded
			header_up X-Forwarded-Proto https
			transport http {
				dial_timeout 5s
				response_header_timeout 150s
			}
		}
	}
	handle {
		root * {$WEB_ROOT}
		header Cache-Control "no-cache"
		@spa path_regexp spa ^/(report/(analyze|confirm)|reports(/(success|[0-9]+))?|admin/(reports(/[0-9]+)?|repeated|incidents/[0-9]+))?/?$
		rewrite @spa /index.html
		file_server
	}
}
